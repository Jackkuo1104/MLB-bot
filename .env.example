# 複製這個檔案並改名為 .env，填入你的資料
DISCORD_TOKEN=貼上你的Discord機器人Token
CHANNEL_ID=要發消息的頻道ID

# 每幾秒檢查一次比分、異動和新聞
CHECK_SECONDS=60

# 即時比分只在明星賽和季後賽發送：開賽、每打完一局（上下半局）發一則摘要（哪隊得幾分、誰打回分數），
# 終場另外發一則勝負結果；例行賽、熱身賽改成當天全部比賽結束後發一則比分連結
# 即時比分只追蹤哪些球隊（縮寫，逗號分隔，例如 LAD,NYY,SD）；留空 = 全部球隊
# 這個設定也會套用到簽約 / 交易通知
FOLLOW_TEAMS=

# 要推送的異動類型：TR 交易、SFA/SGN 簽約、CLW 讓渡認領、REL 釋出、RET 退休、DES 指定讓渡
TX_TYPES=TR,SFA,SGN,CLW,REL,RET
# 是否略過小聯盟合約
SKIP_MINOR_DEALS=true

# 每幾分鐘檢查一次年度獎項（MVP、賽揚、金手套、銀棒、名人堂、經典賽 MVP…，清單自動更新）
# 和每週 / 每月最佳球員、投手、新秀、救援投手、本週最佳美技
AWARD_CHECK_MINUTES=30

# 要推送的 ESPN 新聞類型：HeadlineNews（重大新聞），可再加 Story,Recap,Preview,Media
# 標題或摘要提到紀錄（record、all-time、first player、MLB history…）的新聞不受這個設定影響，一律以「MLB 紀錄」發送
NEWS_TYPES=HeadlineNews
